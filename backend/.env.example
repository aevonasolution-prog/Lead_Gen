# ==============================================================================
# PROPOSED BACKEND ENVIRONMENT CONFIGURATION (PHASE 2 INTEGRATION)
# ==============================================================================
# Copy this file to '.env' once server infrastructure and credentials are provided.
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# CORS Allowed Origins (Comma-separated frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,https://www.yourbusiness.example.com

# Database Connection (To be specified by DB Administrator: PostgreSQL / MongoDB / MySQL)
DATABASE_URL=postgresql://db_user:password@localhost:5432/lead_gen_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# Authentication & Admin Session Security (To be generated: 256-bit cryptographically secure string)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_token_in_production
JWT_EXPIRES_IN=7d

# SMTP / Email Notification Service (Client credentials required in Phase 2)
SMTP_HOST=smtp.mailservice.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=leads-notifier@yourbusiness.example.com
SMTP_PASS=client_smtp_password_placeholder
NOTIFICATION_RECIPIENT_EMAIL=enquiries@yourbusiness.example.com
NOTIFICATION_FROM_NAME="Lead Notification Engine"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS_PER_IP=100
LEAD_SUBMISSION_MAX_PER_HOUR=10
