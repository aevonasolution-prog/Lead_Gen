# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION
# Copy to '.env' for local development. In production set these as environment
# variables in your hosting dashboard. NEVER commit a real .env file.
# ==============================================================================

# --- Server -------------------------------------------------------------------
PORT=5000
NODE_ENV=development            # development | production
API_PREFIX=/api
# Exact frontend origin(s), comma-separated, no trailing slash. Production example:
# ALLOWED_ORIGINS=https://www.yourbusiness.com,https://yourbusiness.com
ALLOWED_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (Render/Railway/Fly/Nginx = 1).
# Needed so rate limiting sees the real visitor IP instead of the proxy's.
TRUST_PROXY=0

# --- Database (PostgreSQL) ----------------------------------------------------
DATABASE_URL=postgresql://lead_user:password@localhost:5432/lead_gen_db
# Managed databases (Render, Neon, Supabase, RDS...) normally require SSL:
DATABASE_SSL=false
# Set to false only if your provider uses a self-signed certificate:
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MIN=2
DB_POOL_MAX=10
# Creates/updates tables automatically on startup (safe to leave on).
RUN_MIGRATIONS_ON_START=true

# --- Admin authentication -----------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_token_in_production
JWT_EXPIRES_IN=12h
# Optional: creates the first admin automatically on startup if none exists.
# Remove ADMIN_PASSWORD from the environment after first successful start.
# (Alternative: run `npm run create-admin -- email 'password'`.)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email notifications (SMTP) ----------------------------------------------
# Use a transactional provider (Brevo, Postmark, Resend, Amazon SES, SendGrid, Mailgun)
# or your domain mailbox host. Leave SMTP_HOST empty in development to just log emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false               # true for port 465
SMTP_USER=
SMTP_PASS=
# Comma-separated list of owner addresses that receive every new lead:
NOTIFICATION_RECIPIENT_EMAIL=enquiries@yourbusiness.example.com
NOTIFICATION_FROM_NAME="Website Enquiries"
# Sender address. MUST be on your domain with SPF/DKIM/DMARC set up (see DEPLOYMENT.md).
# Defaults to SMTP_USER if empty.
NOTIFICATION_FROM_EMAIL=leads@yourbusiness.example.com
# How often (ms) failed notifications are retried (max 5 attempts). 0 disables.
NOTIFICATION_RETRY_INTERVAL_MS=300000

# --- Rate limiting & spam protection ------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS_PER_IP=100
LEAD_SUBMISSION_MAX_PER_HOUR=10
LOGIN_MAX_ATTEMPTS_PER_15_MIN=10
# Optional Cloudflare Turnstile (free CAPTCHA alternative). When set, the frontend
# MUST send `turnstileToken` with each submission or all leads will be rejected.
TURNSTILE_SECRET_KEY=
