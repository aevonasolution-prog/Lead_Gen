# ==============================================================================
# LEAD GENERATION WEBSITE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to '.env' or '.env.local' for local development overrides.
# NOTE: All Vite frontend environment variables MUST be prefixed with VITE_.
# Never commit real secret keys, production credentials, or sensitive tokens here.
# ==============================================================================

# Backend API Base URL (leave pointing to placeholder/mock or local development backend)
VITE_API_BASE_URL=http://localhost:5000/api

# API Request Timeout (in milliseconds)
VITE_API_TIMEOUT_MS=10000

# Site Metadata & Canonical Domain (Update once client supplies production domain)
VITE_SITE_URL=https://www.yourbusiness.example.com
VITE_SITE_NAME="Your Business"

# Environment Mode: 'development' | 'production' | 'staging'
VITE_APP_ENV=development

# Feature Flags
# Set to 'true' to allow simulated lead submissions in development preview mode
VITE_ENABLE_DEV_MOCK_SUBMISSION=false
